THEME=https://raw.githubusercontent.com/bluemoondragon07/Obsidian-Serenity/HEAD/theme.css
BASE_THEME=light
dgHomeLink=true
dgShowBacklinks=true
dgShowLocalGraph=true
dgShowGraphDepthControl=false
dgShowInlineTitle=true
dgShowFileTree=true
dgEnableSearch=true
dgShowToc=true
dgLinkPreview=true
dgShowTags=true
SITE_NAME_HEADER=LEI Wiki
USE_FULL_RESOLUTION_IMAGES=true
STYLE_SETTINGS_CSS=body.css-settings-manager { --img-side-margins: 0; } body.theme-light.css-settings-manager { } body.theme-dark.css-settings-manager { }
STYLE_SETTINGS_BODY_CLASSES=mod-macos is-frameless obsidian-app theme-light show-inline-title is-floating-nav auto-full-screen show-ribbon show-view-header css-settings-manager Auto theme-normal medium-contrast-light medium-contrast-dark flat-mode hide-vault-title link-file file-explorer-normal pure-md font-bundle ia-font h1-bottom-border active-only embed-normal speech-align simple-backlinks active-line-highlight active-pane-highlight hide-ribbon hide-file-tabs hide-file-buttons hide-tabs hide-close-tab hide-titlebar-buttons hide-view-header hide-status-bar hide-backlinks serenity-both iA-cursor cursor-glow hover-context default