THEME=https://raw.githubusercontent.com/bluemoondragon07/Wikipedia-Theme/HEAD/theme.css
BASE_THEME=light
dgHomeLink=true
dgShowBacklinks=true
dgShowLocalGraph=true
dgShowGraphDepthControl=false
dgShowInlineTitle=true
dgShowFileTree=true
dgEnableSearch=true
dgShowToc=true
dgLinkPreview=true
dgShowTags=true
SITE_NAME_HEADER=LEI Wiki
USE_FULL_RESOLUTION_IMAGES=true
STYLE_SETTINGS_CSS=body.css-settings-manager { } body.theme-light.css-settings-manager { } body.theme-dark.css-settings-manager { }
STYLE_SETTINGS_BODY_CLASSES=mod-macos is-frameless obsidian-app theme-light show-inline-title is-floating-nav auto-full-screen show-ribbon show-view-header css-settings-manager ribbon-default frontmatter-default special-h6 float-right